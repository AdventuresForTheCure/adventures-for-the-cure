{
  "name": "adventures-for-the-cure",
  "version": "1.0.0",
  "private": true,
  "description": "The Adventures For the Cure website",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start-local": "npm run build && node server.js",
    "server:dev": "node --watch server.js",
    "dev": "concurrently --kill-others --names api,web \"npm:server:dev\" \"vite --host 0.0.0.0\"",
    "build": "vite build && vite build --config vite.ssr.config.mjs",
    "heroku-postbuild": "npm run build",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm run build && node --test test/server/*.test.js",
    "test:client": "vitest run",
    "audit": "npm audit --audit-level=low"
  },
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "morgan": "^1.12.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^29.1.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
